[en-us]
name = "FileBrowser Quantum"
auth = "FileBrowser"
version = "2.0.8.0"
descript = "Filebrowser Quantum provides a file managing interface within a specified directory and it can be used to upload, delete, preview, rename and edit your files. It allows the creation of multiple users and each user can have its own directory. It can be used as a standalone app or as a middleware."

